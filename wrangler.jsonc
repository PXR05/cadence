{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cadence",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2025-12-31",
  "compatibility_flags": ["nodejs_als"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "observability": {
    "enabled": true
  }
}
